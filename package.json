{
  "name": "tokenlint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Audit, validate, and bind design tokens directly in Figma.",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json",
    "test": "node scripts/test.mjs",
    "test:offline": "node scripts/test-offline.mjs",
    "test:vitest": "npm exec --yes --package=vitest@5.1.1 --package=vite@6.4.1 -- vitest run --globals"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.123.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.25.12",
    "tailwindcss": "4.1.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
